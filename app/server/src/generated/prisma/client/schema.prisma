// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

// スケジュール設定（常に id=1 のシングルトン）
model Schedule {
  id            Int       @id @default(1)
  channelId     String    @db.VarChar(36)
  postDay       Int // 毎月何日に質問を投稿するか (1-28)
  lotteryDay    Int // 毎月何日に抽選するか (postDay < lotteryDay, 2-28)
  enabled       Boolean   @default(true)
  // 状態追跡
  lastPostedAt  DateTime? // 直近の投稿日時
  lastMessageId String?   @db.VarChar(36) // 直近の投稿メッセージ ID
  lastLotteryAt DateTime? // 直近の抽選実行日時
  updatedAt     DateTime  @updatedAt
}

// 抽選結果
model LotteryResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  channelId String   @db.VarChar(36)
  month     String   @db.VarChar(7) // "YYYY-MM"
  result    Json // LotteryResponse をシリアライズしたもの
}
