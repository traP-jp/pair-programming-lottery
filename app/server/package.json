{
    "name": "server",
    "private": true,
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate deploy",
        "db:migrate:dev": "bunx --bun prisma migrate dev",
        "dev": "bun run --watch ./src/index.ts",
        "test": "bun test",
        "typecheck": "bunx --bun tsc --noEmit --skipLibCheck false"
    },
    "dependencies": {
        "@prisma/adapter-mariadb": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prisma/client-runtime-utils": "^7.8.0",
        "dotenv": "^17.4.2",
        "dotenv-expand": "^13.0.0",
        "hono": "^4.12.29",
        "traq-bot-ts": "^1.5.2"
    },
    "devDependencies": {
        "@types/ws": "^8.18.1",
        "prisma": "^7.8.0",
        "typescript": "^7.0.2"
    }
}
