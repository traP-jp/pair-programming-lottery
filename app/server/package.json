{
    "name": "server",
    "private": true,
    "scripts": {
        "dev": "bun run --watch ./src/index.ts",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate deploy",
        "db:migrate:dev": "bunx --bun prisma migrate dev",
        "typecheck": "bunx --bun tsc --noEmit --skipLibCheck false",
        "test": "bun test"
    },
    "dependencies": {
        "@prisma/adapter-mariadb": "^7.7.0",
        "@prisma/client": "^7.7.0",
        "@prisma/client-runtime-utils": "^7.7.0",
        "dotenv": "^17.4.1",
        "dotenv-expand": "^13.0.0",
        "traq-bot-ts": "^1.5"
    },
    "devDependencies": {
        "@types/ws": "^8.18.1",
        "prisma": "^7.7.0"
    }
}
