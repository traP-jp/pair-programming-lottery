{
    "name": "pair-programming-lottery",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "docker compose -f compose.yaml -f compose.dev.yaml up -d",
        "dev:build": "bun run --bun dev --build",
        "down": "docker compose down",
        "check:type": "bun run --filter client typecheck && bun run --filter server typecheck",
        "check:lint": "eslint . --cache",
        "check:lint:fix": "eslint . --fix --cache",
        "check:format": "prettier --check --cache .",
        "check:format:fix": "prettier --write --cache .",
        "check": "bun run --bun check:lint && bun run --bun check:format && bun run --bun check:type",
        "check:fix": "bun run --bun check:lint:fix && bun run --bun check:format:fix && bun run --bun check:type",
        "husky:prepare": "cd .. && husky app/.husky"
    },
    "dependencies": {
        "hono": "^4.12"
    },
    "devDependencies": {
        "@eslint/css": "^1.3.0",
        "@eslint/js": "^9.21.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/bun": "^1.3",
        "@types/node": "^25.5.2",
        "@types/ws": "^8.18.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.2.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^65.0.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.4",
        "typescript": "^6.0",
        "typescript-eslint": "^8.61.0"
    },
    "optionalDependencies": {
        "@esbuild/linux-x64": "*",
        "@esbuild/linux-arm64": "*",
        "@rollup/rollup-linux-x64-gnu": "*",
        "@rollup/rollup-linux-arm64-gnu": "*"
    },
    "trustedDependencies": [
        "prisma",
        "@prisma/client"
    ],
    "workspaces": [
        "server",
        "client"
    ]
}
